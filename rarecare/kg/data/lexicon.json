{
  "_meta": {
    "description": "Lay, euphemistic and Hinglish surface forms mapped to clinical concept ids. Patterns are case-insensitive regular expressions applied to normalised text. 'register' records which language register the pattern belongs to; it drives StigmaSymp-W vignette generation and the euphemism-gap analysis."
  },
  "concepts": {
    "breast_lump": {
      "label": "Breast lump",
      "cancers": [
        "breast"
      ],
      "patterns": [
        {
          "p": "\\b(breast|boob|chest)\\s+(lump|mass|swelling|knot)\\b",
          "register": "lay"
        },
        {
          "p": "\\b(lump|mass|knot|swelling|hard spot)\\s+(in|on|near)\\s+(my\\s+)?(left\\s+|right\\s+)?(breast|boob|chest)\\b",
          "register": "lay"
        },
        {
          "p": "\\bpalpable (breast )?mass\\b",
          "register": "clinical"
        },
        {
          "p": "\\b(chhati|chaati|seene)\\s+(mein|me)\\s+gaanth\\b",
          "register": "hinglish"
        },
        {
          "p": "\\bsomething hard (in|on) (my )?(breast|chest)\\b",
          "register": "euphemistic"
        }
      ]
    },
    "nipple_discharge": {
